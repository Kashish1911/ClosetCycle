# Vite uses this during build. Set it to the HTTPS API URL after deployment.
VITE_API_BASE_URL=http://localhost:8080

# Local PostgreSQL Docker Compose values. Generate secrets locally; never commit a real .env.
DATABASE_PASSWORD=change-this-local-demo-password
CLOSET_CYCLE_JWT_SECRET=base64-encode-at-least-32-random-bytes

# Razorpay test/live credentials. Keep all secrets server-side; never use real keys in source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
